# Local development only — Vite loads this for `npm run dev`, never for `npm run build`.
# Delete this file (or rename it) to point the dev server back at production.
VITE_API_BASE_URL=https://api.ranlogic.com/api
VITE_API_URL=https://api.ranlogic.com
# trailing slash: echo.js builds `${VITE_BACKEND_URL}broadcasting/auth`
VITE_BACKEND_URL=https://api.ranlogic.com
