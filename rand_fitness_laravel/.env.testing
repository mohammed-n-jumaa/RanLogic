# Local Playwright/parity test environment for ranlogic-front. Generated from .env; not for production.
# Every external service credential is blanked so tests cannot reach PayPal, Pusher, OneSignal, Firebase, mail or AWS.
APP_NAME=Laravel
APP_ENV=testing
APP_KEY=base64:/WwbQ3zQjIn1LHFtWjxz8V3XSYe1gBYIObX4d71FrT0=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=Rand_Fitness_test
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
BROADCAST_CONNECTION=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY=
VITE_PUSHER_HOST=
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

PHP_POST_MAX_SIZE=200M
PAYPAL_CLIENT_ID=
PHP_UPLOAD_MAX_FILESIZE=200M
PAYPAL_CURRENCY=USD
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=
FIREBASE_VAPID_PUBLIC=
FIREBASE_VAPID_PRIVATE_PEM=
FIREBASE_VAPID_PRIVATE=
ONE_SIGNAL_APP_ID=
ONE_SIGNAL_REST_API_KEY=


PAYPAL_SECRET=
PAYPAL_SANDBOX=true
